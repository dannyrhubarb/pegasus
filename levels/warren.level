# Level — The Warren: the third hand-drawn world, the expert's burrow. A
# four-storey maze — basement, ground halls, upper lofts and the crown —
# with SEVEN pads, and the two hardest landings in the game so far: the
# crown's freestanding pillar top and the basement pad tucked under a low
# lintel you must approach slow and level. The east tunnel is a chicane
# (two rock teeth, ~2.6 m gaps — the long way round via the crown is
# always open to the cautious), and two expert-only slits shortcut whole
# wings: slit A drops the loft straight into the crown, slit B threads
# from the west tunnel down into the basement. TIME-scored: the clock
# starts at your first input and the last pad ends the run. The route is
# long enough that fuel is a real resource at race pace — pads refuel
# while you sit on them, so a record run has to decide where the tank is
# worth the seconds.
#
# Map (side view, y up; ~148 x 88 m):
#              ┌──────── CROWN (pillar pad) ────────┐    y 42..54
#      slitA┐  └──┬(chimney x -2..2)──┬(x 20..24.5)─┘
#   ┌─── NW LOFT ─┴──┐█divider█┌── NE GALLERY ── pad ┐   y 24..36
#   └─┬(x -44..-39.5)┘   ║     └──────┬(x 52..56.5)──┘
#  ┌──┴ WEST HALL ┐═WT+pad═┌ CORE ┐═ET(chicane)═┌ EAST HALL ┐  y 0..12
#  └┬(x -52..-47.5)──┬slitB┘  └┬(x 2..6.5)──────└── pad ────┘
#   ┌┴───── BASEMENT ┴(low lintel + pad)──┴─────┐        y -18..-9
#   └───────────────────────────────────────────┘
#
# Rock polygons overlap on purpose (buried edges are unreachable); slabs
# are generated with deterministic edge jitter, then probe-validated:
# every chamber, riser, slit, chicane gap and landing pocket is open.
name = The Warren
description = Seven pads in a tangled burrow. Slits for the brave, fuel for the careful
scoring = time
shafts = off
obstacles = off

# Neutral start platform in the core — launches the run, refuels nothing.
start = 0,0.7

# The seven pads: basement (under the low lintel), west hall, east hall,
# the west-tunnel sill perch, NW loft (low local ceiling), NE gallery far
# east, and the crown pillar top.
pad = -30,-17.4
pad = -58,0.7
pad = 58,0.7
pad = -17,2.6
pad = -55,24.6
pad = 44,24.6
pad = 9,47.4

# Frame walls, crown ceiling, basement floor; then the storeys bottom-up:
# basement fills + lintel + boulder, the floor slab (split by the west
# drop, slit B and the core drop), tunnel sills/lintels + chicane teeth,
# the mid slab (split by the risers and the chimney), the upper divider,
# lofts, the upper slab (split by slit A, the chimney and the east
# passage), and the crown with its pillar.
