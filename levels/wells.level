# Level — Well, well, well: a hand-drawn cavern with three vertical wells
# sunk into its floor, each ending in a landing base.
#
#   cavern (x -26..140, y 0..30, uneven roof + floor humps, no
#           stalactites — the ceiling is clear)
#     │ start platform at x = 0
#     ├─ well 1 @ x 30  — winding: three smooth turns,  60 m deep
#     ├─ well 2 @ x 60  — siphon: down, U-turn UP, reversed U-turn back
#     │                   DOWN to the floor,            56 m deep
#     └─ well 3 @ x 118 — almost straight,              90 m deep
#
# TIME-scored: the clock starts at your first input, the HUD counts bases
# x/3, and touching down on the last unvisited base ends the run — lowest
# time wins. Five times the usual endurance: a 500-unit tank (`fuel`) with
# the pit-stop rate raised to match (`refuel_rate = 125`, so refilling it
# still takes the stock four seconds and the percentage gauge reads the
# same as everywhere else). The wells are long enough that the stock tank
# turned the climbs into a fuel puzzle instead of a flying one.
#
# Wall polylines are perpendicular offsets of each well's centre line (the
# corridor keeps its width however steeply the shaft leans or turns), and
# every well leaves its mouth and reaches its floor dead vertical, so the
# opening is a clean hole and the base sits on flat ground. The rock is one
# BLOCK per well, each cut by a keyhole slit tracing that well's void — a
# shape that doubles back, like well 2, has no consistent "left wall" for
# the older strip scheme to lean on. Solid rock extends 45 m past anything
# reachable so no lit edge band is ever visible hanging in the void.
name = Well, well, well
description = Three wells, three bases. Down and up each, against the clock
scoring = time
shafts = off
obstacles = off
fuel = 500
refuel_rate = 125

# Neutral start platform in the cavern — the launch spot, NOT one of the
# bases to visit (and it does not refuel).
start = 0,0.4

# The three bases, one on each well floor.
pad = 30,-59.6
pad = 96,-55.6
pad = 119.16,-89.6

# Rock block around well 1 (winding), slit open at its mouth.
