# Level — The Descent: the second hand-drawn world, built to invert The
# Hollows: the spawn is at the TOP and every pad is further DOWN. Five
# storeys stacked into a chasm, joined by offset vertical shafts so no
# single free-fall clears the map — every drop ends at rock you must brake
# for (flip-and-burn is the whole skill here; lunar gravity builds speed
# fast and CRASH_DV_HARD is only 6 m/s). One pad goes against the grain:
# the LOFT, a pocket above the vault reached by a tight 2.8 m chimney —
# climb in, kill your velocity, settle. TIME-scored: the clock starts at
# your first input and the last pad ends the run. Braking burns real fuel,
# so racing the clock also races the tank — pads top you up while parked.
#
# Map (side view, y up; ~120 x 100 m):
#     ┌──────────────────────────────┐
#     │  SUMMIT (spawn)  x -26..26   │  y  0..12
#     └──────────────┬(A x 13..17.5)─┘
#   ┌────────────────┴─────────────────┐
#   │  GALLERY            pad ── east  │  y -16..-6.5
#   └─┬(B x -30..-25.5)────────────────┘
#  ┌──┴────────────┌loft pad┐───────┐
#  │  VAULT  pad ──west  └┬(chimney)│  y -38..-26.5 (loft y -22.5..-18.7)
#  └──────────────────────┴─┬(C x 3..7.5)
#     ┌─────────────────────┴──▼▼──────────┐
#     │  DEEP HALL (ceiling teeth)  pad ─east │  y -56..-44.5
#     └───────────────────┬(DROP x 38..42.5)┘
#              ┌──────────┴──────────┐
#              │  THE FLOOR  pad ─west │  y -80..-68
#              └─────────────────────┘
#
# Rock polygons overlap on purpose (buried edges are unreachable); slabs
# are generated with deterministic edge jitter, then probe-validated:
# every chamber, shaft, corridor and landing pocket is open space.
name = The Descent
description = Five pads down a five-storey chasm. Brake or break
scoring = time
shafts = off
obstacles = off

# Neutral start platform on the summit — launches the run, refuels nothing.
start = 0,0.3

# The five pads, top to bottom: gallery east, the loft (the chimney-climb
# pocket above the vault), vault west, deep hall east, the floor.
pad = 32,-15.3
pad = -1.2,-21.6
pad = -44,-37.4
pad = 50,-55.4
pad = 22,-79.3

# Frame: left/right walls, summit ceiling, chasm floor.
