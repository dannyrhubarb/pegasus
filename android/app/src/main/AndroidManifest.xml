<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Online high scores, the ghost and analytics; the game itself is
         fully bundled and runs offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- BLE nearby-link SPIKE (BleBridge.kt, docs/multiplayer-ble.md). All
         requested lazily, on the first host/scan command from the spike
         screen — the game never prompts at launch. Android 12+ has the
         dedicated Bluetooth runtime permissions (SCAN flagged
         neverForLocation, so Play does not treat it as location access);
         older releases gate BLE scanning on fine location, capped at API 30
         so the modern builds never declare it. BLE is not required
         hardware: the spike screen just reports "no BLE hardware". -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- enableOnBackInvokedCallback=false: targeting API 36 turns predictive
         back ON by default, which stops delivering onBackPressed() — and
         MainActivity's onBackPressed IS the back button here (system back =
         one screen back in the game's history stack). Opting out keeps the
         legacy callback until we migrate to OnBackInvokedDispatcher. -->
    <application
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/AppTheme">
        <!-- configChanges keeps the activity (and the WebView with the live
             game state) alive across rotation — a recreate would reload the
             page mid-flight. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android App Links: https://pegasusmoonlander.com/ opens in the
                 app once the OS has verified .well-known/assetlinks.json on
                 the live domain against THIS build's signing certificate
                 (the release applicationId + Play's app-signing key; the
                 .preview test APK is deliberately unlisted, so its links
                 stay in the browser). Root + index.html only — previews
                 (pr-<n>/), the editor, the APK download and the document
                 pages must keep opening in the browser. Path matching
                 ignores the query string, which MainActivity forwards. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="pegasusmoonlander.com" />
                <data android:path="/" />
                <data android:path="/index.html" />
            </intent-filter>
        </activity>
    </application>
</manifest>
